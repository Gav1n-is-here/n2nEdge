<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="n2n edge" Width="880" Height="850" MinWidth="720" MinHeight="620" Background="#F6F8F5" FontFamily="Microsoft YaHei UI" FontSize="14" Foreground="#192D25" WindowStartupLocation="CenterScreen">
<Window.Resources>
<Style TargetType="Button"><Setter Property="Background" Value="#DDEBE2"/><Setter Property="Foreground" Value="#164E39"/><Setter Property="Padding" Value="20,11"/><Setter Property="Margin" Value="0,4,10,4"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="22" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TextBox"><Setter Property="Padding" Value="12,10"/><Setter Property="Background" Value="#FAFCF9"/><Setter Property="BorderBrush" Value="#B9C9BD"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Background="{TemplateBinding Background}" CornerRadius="8"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#147D56"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="PasswordBox"><Setter Property="Padding" Value="12,10"/><Setter Property="Background" Value="#FAFCF9"/><Setter Property="BorderBrush" Value="#B9C9BD"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Border x:Name="outline" CornerRadius="8" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="outline" Property="BorderBrush" Value="#147D56"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="outline" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="ComboBox"><Setter Property="Padding" Value="12,10"/><Setter Property="MinHeight" Value="42"/><Setter Property="Background" Value="#FAFCF9"/><Setter Property="BorderBrush" Value="#B9C9BD"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border x:Name="outline" CornerRadius="8" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}"/><ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Grid Background="Transparent"><Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" Data="M0,0 L5,5 L10,0" Stroke="#496354" StrokeThickness="1.5"/></Grid></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Margin="12,8,34,8" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" CornerRadius="8" BorderBrush="#B9C9BD" BorderThickness="1" Background="#FAFCF9" Padding="5" Margin="0,4,0,0"><ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="outline" Property="BorderBrush" Value="#147D56"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="outline" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="label" TargetType="TextBlock"><Setter Property="Margin" Value="0,14,0,6"/><Setter Property="Foreground" Value="#496354"/></Style>
</Window.Resources>
<ScrollViewer Background="#F6F8F5" VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,24">
<DockPanel><Image x:Name="BrandIcon" Width="48" Height="48" Margin="0,0,14,0"/><TextBlock Text="n2n edge" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="Architecture" Text="WINDOWS" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#607B69"/></DockPanel>
<TextBlock Text="让设备加入同一个虚拟局域网" Foreground="#64776B" Margin="0,6,0,22"/>
<Border Background="#DCEEE1" CornerRadius="24" Padding="24"><StackPanel><TextBlock x:Name="Status" Text="未连接" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="Detail" Text="配置社区和密钥，连接你的设备" TextWrapping="Wrap" Margin="0,8,0,14"/><WrapPanel><Button x:Name="Connect" Content="连接子网" Background="#176B49" Foreground="White"/><Button x:Name="Probe" Content="检测节点"/><Button x:Name="Save" Content="保存配置"/></WrapPanel></StackPanel></Border>
<Border Background="White" CornerRadius="20" Padding="24" Margin="0,18,0,0"><StackPanel x:Name="Settings">
<TextBlock Text="连接配置" FontSize="19" FontWeight="SemiBold"/>
<TextBlock Text="服务节点" Style="{StaticResource label}"/><TextBox x:Name="Server" ToolTip="主机:UDP端口"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="社区 Community" Style="{StaticResource label}"/><TextBox x:Name="Community"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="共享密钥" Style="{StaticResource label}"/><PasswordBox x:Name="Key"/></StackPanel></Grid>
<TextBlock Text="同一社区的设备使用相同密钥和加密算法，每台设备使用不同 IP。" Foreground="#64776B" FontSize="12" Margin="0,9,0,0" TextWrapping="Wrap"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="虚拟 IPv4" Style="{StaticResource label}"/><TextBox x:Name="Ip"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="子网掩码" Style="{StaticResource label}"/><TextBox x:Name="Mask"/></StackPanel></Grid>
<TextBlock Text="TAP 虚拟网卡" Style="{StaticResource label}"/><ComboBox x:Name="Adapter" DisplayMemberPath="Name"/>
<WrapPanel Margin="0,6,0,0"><Button x:Name="Refresh" Content="刷新网卡"/><Button x:Name="Driver" Content="安装 TAP 驱动"/></WrapPanel>
<Expander Header="高级设置" Margin="0,16,0,0"><StackPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="加密算法" Style="{StaticResource label}"/><ComboBox x:Name="Cipher"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="MTU" Style="{StaticResource label}"/><TextBox x:Name="Mtu"/></StackPanel></Grid>
<TextBlock Text="MAC 地址（留空使用所选网卡地址）" Style="{StaticResource label}"/><TextBox x:Name="Mac"/>
<CheckBox x:Name="Header" Content="启用头部加密（节点须预配置社区）" Margin="0,15,0,8"/>
<CheckBox x:Name="Relay" Content="强制经节点中转（关闭时优先尝试设备直连）" Margin="0,8"/>
<CheckBox x:Name="Multicast" Content="接收子网组播（用于部分局域网发现功能）" Margin="0,8"/>
</StackPanel></Expander>
</StackPanel></Border>
<Border Background="White" CornerRadius="20" Padding="24" Margin="0,18,0,0"><StackPanel><TextBlock Text="连接日志" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBox x:Name="Logs" IsReadOnly="True" Height="165" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/><Button x:Name="Copy" Content="复制日志" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Border>
<TextBlock Text="n2n 3.0 · 只连接配置的虚拟子网 · 密钥由 Windows 加密保存" FontSize="12" Foreground="#64776B" Margin="0,18,0,0"/>
</StackPanel></ScrollViewer></Window>
